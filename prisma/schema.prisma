



generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id                 Int                  @id @default(autoincrement())
  name               String
  address            String?
  phone              String?
  email              String?
  notes              String?
  units              ClientUnit[]
  quotes             Quote[]
  emailNotifications EmailNotifications[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model ClientUnit {
  id                 Int                  @id @default(autoincrement())
  clientId           Int
  brand              String
  model              String
  powerKw            Float?
  serialNumber       String?
  installation       DateTime?   // Tervezett telepítés
  installedAt        DateTime?   // Tényleges készre jelölés
  periodMonths       Int                  @default(12)
  location           String?
  notes              String?
  status             String               @default("PENDING")
  maintenance        MaintenanceLog[]
  emailNotifications EmailNotifications[]
  client             Client               @relation(fields: [clientId], references: [id])
}

model MaintenanceLog {
  id            Int       @id @default(autoincrement())
  unitId        Int
  performedDate DateTime
  description   String?
  type          String    @default("MAINTENANCE")
  materials     String?
  costInternal  Int?
  technicianId  Int?
  nextDue       DateTime?
  photos        String?
  unit          ClientUnit @relation(fields: [unitId], references: [id])
}

model EmailNotifications {
  id               Int      @id @default(autoincrement())
  clientId         Int
  clientUnitId     Int
  notificationType String
  sentToEmail      String
  sentAt           DateTime @default(now())
  status           String
  client           Client   @relation(fields: [clientId], references: [id])
  unit             ClientUnit @relation(fields: [clientUnitId], references: [id])
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
}

model Quote {
  id         Int         @id @default(autoincrement())
  clientId   Int
  client     Client      @relation(fields: [clientId], references: [id])
  title      String?
  status     QuoteStatus @default(draft)
  terms      String?
  netTotal   Decimal     @default(0)
  vatAmount  Decimal     @default(0)
  grossTotal Decimal     @default(0)
  items      QuoteItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model QuoteItem {
  id           Int      @id @default(autoincrement())
  quoteId      Int
  quote        Quote    @relation(fields: [quoteId], references: [id])
  description  String
  quantity     Decimal  @default(1)
  unit         String?
  unitPriceNet Decimal  @default(0)
  vatRate      Decimal  @default(27)
  lineNet      Decimal  @default(0)
  lineVat      Decimal  @default(0)
  lineGross    Decimal  @default(0)
  costNet      Decimal? @default(0)
  profitAbs    Decimal? @default(0)
  profitPct    Decimal? @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model Item {
  id           Int      @id @default(autoincrement())
  brand        String?  
  name         String
  price        Float
  sku          String?
  serialNumber String?
  stock        Int      @default(0)
  supplier     String?
  unit         String   @default("db")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("items")
}

model CalendarEvent {
  id            Int      @id @default(autoincrement())
  unitId        Int
  performedDate DateTime
  description   String?
  type          String   @default("MAINTENANCE")
} 

// 🛠️ MUNKÁK / TELEPÍTÉSEK MODEL
model Task {
  id             Int      @id @default(autoincrement())
  type           String   @default("installation")
  title          String?
  clientName     String?
  phone          String?
  address        String?
  assignedTo     String?
  date           String?
  description    String?
  status         String   @default("pending")
  scheduled_at   DateTime?
  completed_at   DateTime?
  images         String   @default("[]")
  machines       String   @default("[]")

  // Gépenkénti kiegészítő adatok JSON formátumban
  // Karbantartás típusa: "mosas" vagy "fertotlenites"
  // Garanciális állapot: true vagy false
  machineDetails String   @default("[]")

  // A teljes munka fizetési módja:
  // "keszpenz" vagy "atutalas"
  paymentMethod  String?

  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EmailSetting {
  id    Int    @id @default(autoincrement())
  email String @unique
}

enum MaintenanceServiceType {
  WASH
  DISINFECTION
}
enum MaintenancePaymentMethod {
  CASH
  TRANSFER
}

enum MaintenanceReceiver {
  FIRST_PERSON
  SECOND_PERSON
}

enum MaintenanceAuditEventType {
  PRICE_CREATED
  SETTLEMENT_ITEM_CREATED
  PERIOD_RESET
  SETTLEMENT_ITEM_ADJUSTED
  SETTLEMENT_ITEM_VOIDED
}

model MaintenancePrice {
  id                 Int                    @id @default(autoincrement())
  maintenanceType    MaintenanceServiceType
  totalPrice         Int
  firstPersonAmount  Int
  secondPersonAmount Int
  validFrom          DateTime               @default(now())
  createdAt          DateTime               @default(now())

  settlementItems MaintenanceSettlementItem[]

  @@index([maintenanceType, validFrom])
  @@index([createdAt])
}

model MaintenanceSettlementPeriod {
  id        Int       @id @default(autoincrement())
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  items MaintenanceSettlementItem[]

  @@index([startedAt])
  @@index([endedAt])
}

model MaintenanceSettlementItem {
  id                 Int                    @id @default(autoincrement())
  taskId             Int
  machineIndex       Int
  clientName         String?
  machineName        String
 maintenanceType    MaintenanceServiceType
paymentMethod      MaintenancePaymentMethod?
receivedBy         MaintenanceReceiver?
appliedPrice       Int
  firstPersonAmount  Int
  secondPersonAmount Int
  completedAt        DateTime
  periodId           Int
  priceId            Int
  createdAt          DateTime               @default(now())

  period MaintenanceSettlementPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  price  MaintenancePrice            @relation(fields: [priceId], references: [id], onDelete: Restrict)

  @@unique([taskId, machineIndex])
  @@index([periodId])
  @@index([priceId])
  @@index([completedAt])
  @@index([maintenanceType])
@@index([paymentMethod])
@@index([receivedBy])
  @@index([clientName])
}

model MaintenanceAuditLog {
  id          Int                       @id @default(autoincrement())
  eventType   MaintenanceAuditEventType
  entityType  String
  entityId    Int?
  description String?
  details     Json
  createdAt   DateTime                  @default(now())

  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
}
