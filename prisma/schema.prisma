datasource db {
  provider = "postgresql" // vagy sqlite / mysql, amit használsz
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Item {
  id           Int     @id @default(autoincrement())
  brand        String? // <-- EZ A MEZŐ ENGEDÉLYEZI A GYÁRTÓT
  name         String
  price        Float   @default(0)
  sku          String?
  serialNumber String?
  stock        Int     @default(0)
  supplier     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
